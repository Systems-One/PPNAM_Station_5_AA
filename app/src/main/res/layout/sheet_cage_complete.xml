<?xml version="1.0" encoding="utf-8"?>
<!-- Completion summary bottom sheet (spec §4.4). Never auto-confirmed. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/card_background"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvSheetTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold"
        tools:text="Complete CAGE-007?" />

    <TextView
        android:id="@+id/tvSheetSummary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        tools:text="14 Packs · 352.40 kg" />

    <TextView
        android:id="@+id/tvSheetJob"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/text_muted"
        android:textSize="14sp"
        tools:text="Job 510019399 · OUTER-001" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/cage_complete_warning"
        android:textColor="@color/warning"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/tvSheetCountdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/text_muted"
        android:textSize="13sp"
        tools:text="Summary expires in 1:45" />

    <LinearLayout
        android:id="@+id/rowSheetSending"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ProgressBar
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:indeterminateTint="@color/text_muted" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/cage_sending"
            android:textColor="@color/text_muted"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKeepLoading"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="@string/cage_keep_loading"
            android:textColor="@color/text_primary"
            app:strokeColor="@color/border_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCompleteCage"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="@color/station_field"
            android:text="@string/cage_complete_cage"
            android:textColor="@color/text_primary" />
    </LinearLayout>
</LinearLayout>

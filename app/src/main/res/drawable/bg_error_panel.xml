<?xml version="1.0" encoding="utf-8"?>
<!-- Suite standard C3: an error is a tinted red panel, not a bare red line (as Station 3's
     bg_scan_status_error). Text on it is text_primary: danger on light_red is only 3.99:1
     (skill-run critique 2026-11-06, P2-3). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/light_red" />
    <stroke android:width="1dp" android:color="@color/danger" />
    <corners android:radius="12dp" />
</shape>
